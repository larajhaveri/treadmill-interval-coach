# Copy this file to .env.local for local development. Never commit .env.local.
# Both values come from Supabase: Project Settings -> API Keys.
# The publishable key is safe to expose to the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: PostHog analytics (Project settings -> Project API key). Leave both out to turn analytics off.
# The project key is meant to be public. Use the host for your region: https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
