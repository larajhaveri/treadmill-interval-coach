# Copy this file to .env.local for local development. Never commit .env.local.
# Both values come from Supabase: Project Settings -> API Keys.
# The publishable key is safe to expose to the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
